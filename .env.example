# Data paths are automatic: ~/.neuron404 locally and /data inside Docker.
# Set these to your user and group IDs if they differ from 1000 (id -u / id -g).
# NEURON404_UID=1000
# NEURON404_GID=1000

# Maintenance is disabled unless a provider is explicitly selected (claude or codex).
# NEURON404_MAINTENANCE_PROVIDER=none
# Optional executable path and model override for the selected provider.
# NEURON404_MAINTENANCE_CLI=
# NEURON404_MAINTENANCE_MODEL=
# NEURON404_MAINTENANCE_POLL_SECONDS=30
# NEURON404_MAINTENANCE_SETTLE_SECONDS=60
# NEURON404_MAINTENANCE_TIMEOUT_SECONDS=120
# NEURON404_MAINTENANCE_MAX_ATTEMPTS=3
# NEURON404_MAINTENANCE_MAX_REQUESTS_PER_HOUR=4
# NEURON404_MAINTENANCE_MAX_BUDGET_USD=0.5
# NEURON404_MAINTENANCE_MAX_INPUT_BYTES=200000
# NEURON404_MAINTENANCE_AUDIT_INTERVAL_DAYS=7

# Optional server access. Generate a secret with: openssl rand -hex 32
# With no auth token, the web stays local and the remote API is disabled.
# NEURON404_AUTH_TOKEN=
# Optional separate token for read-only API access; cannot sign into the web.
# NEURON404_READ_TOKEN=
# HTTPS origin behind a reverse proxy; requires the auth token above.
# NEURON404_PUBLIC_URL=https://neuron.example.com

# Client only: export in the shell that launches the skill or bin/neuron404.
# NEURON404_URL=https://neuron.example.com
# NEURON404_TOKEN=
# Reuse after an uncertain write with identical command arguments and payload.
# NEURON404_REQUEST_ID=
# Optional Cloudflare Access service credentials for the remote client.
# CF_ACCESS_CLIENT_ID=
# CF_ACCESS_CLIENT_SECRET=
