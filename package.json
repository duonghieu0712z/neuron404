{
    "name": "neuron404",
    "version": "0.0.1",
    "private": true,
    "license": "MIT",
    "author": "duonghieu0712z",
    "type": "module",
    "imports": {
        "#lib": "./src/lib/index.js",
        "#lib/*": "./src/lib/*"
    },
    "scripts": {
        "build": "run-p type-check \"build-only {@}\" --",
        "build-only": "vite build",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:push": "drizzle-kit push",
        "db:studio": "drizzle-kit studio",
        "dev": "vite dev",
        "format": "prettier --check .",
        "format:fix": "prettier --write .",
        "lint": "eslint . --cache",
        "lint:fix": "eslint --fix . --cache",
        "prepare": "svelte-kit sync || echo '' && husky",
        "preview": "vite preview",
        "type-check": "pnpm check"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.4",
        "@commitlint/config-conventional": "^21.2.4",
        "@eslint/js": "^10.0.1",
        "@fontsource-variable/inter": "^5.3.0",
        "@libsql/client": "^0.18.0",
        "@lucide/svelte": "^1.66.0",
        "@sveltejs/adapter-auto": "^8.0.0",
        "@sveltejs/kit": "^3.1.1",
        "@sveltejs/vite-plugin-svelte": "^7.3.1",
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^26",
        "cn": "^0.5.2",
        "drizzle-kit": "^0.31.11",
        "drizzle-orm": "^0.45.4",
        "eslint": "^10.14.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-perfectionist": "^5.13.0",
        "eslint-plugin-svelte": "^3.23.1",
        "globals": "^17.14.0",
        "husky": "^9.1.7",
        "jiti": "^2.7.0",
        "lint-staged": "^17.6.0",
        "npm-run-all2": "^9.0.4",
        "prettier": "^3.9.10",
        "prettier-plugin-packagejson": "^3.1.0",
        "prettier-plugin-svelte": "^4.1.1",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "shadcn-svelte": "^1.7.2",
        "svelte": "^5.57.3",
        "svelte-check": "^4.7.8",
        "tailwind-variants": "^4.0.1",
        "tailwindcss": "^4.3.3",
        "tw-animate-css": "^1.4.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.1",
        "vite": "^8.3.5"
    },
    "packageManager": "pnpm@12.16.1",
    "engines": {
        "node": ">=24"
    }
}
