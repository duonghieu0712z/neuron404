#!/bin/sh
set -eu
NEURON404_SKILL_ROOT=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd -P)
if [ "${1:-}" = "remote" ]; then
    shift
    exec node "$NEURON404_SKILL_ROOT/scripts/remote.mjs" "$@"
fi
if [ -n "${NEURON404_HOME:-}" ]; then
    NEURON404_REPOSITORY=$NEURON404_HOME
else
    NEURON404_REPOSITORY=$(CDPATH='' cd -- "$NEURON404_SKILL_ROOT/../.." && pwd -P)
fi
if [ ! -x "$NEURON404_REPOSITORY/bin/neuron404" ]; then
    printf '%s\n' 'Cannot locate the neuron404 repository. Set NEURON404_HOME to its absolute path.' >&2
    exit 1
fi
exec "$NEURON404_REPOSITORY/bin/neuron404" "$@"
